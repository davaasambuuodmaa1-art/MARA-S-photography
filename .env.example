# --- Mara's Photography environment ---
# Nothing here is required for the app to run. Without these the app uses
# clearly-labelled sandbox payment simulation and logs emails to the admin inbox.
# All charges are in Australian dollars (AUD).

# Public site URL (used for Stripe redirects and email links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe — create test keys at https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Transactional email (Resend) — https://resend.com/api-keys
RESEND_API_KEY=
EMAIL_FROM="Mara's Photography <studio@marasphotography.com>"
ADMIN_EMAIL=studio@marasphotography.com

# Signs session cookies — set a long random value in production
AUTH_SECRET=

# Seeded administrator (change before going live)
SEED_ADMIN_EMAIL=admin@marasphotography.com
SEED_ADMIN_PASSWORD=MaraStudio2026!
