# --- Mara's Photography environment ---
# Public pages can run without these values. Configure the admin bootstrap and
# production secrets before enabling owner access or live payments.
# All charges are in Australian dollars (AUD).

# Public site URL (used for Stripe redirects and email links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe — create test keys at https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Transactional email (Resend) — https://resend.com/api-keys
RESEND_API_KEY=
EMAIL_FROM="Mara's Photography <studio@marasphotography.com>"
ADMIN_EMAIL=marlaa9939@yahoo.com

# Signs session cookies — required in production, use a long random value
AUTH_SECRET=

# Temporary first-run administrator account. Use a unique password with at
# least 12 characters. After signing in, complete /admin/setup to create the
# two separate owner/admin accounts.
SEED_ADMIN_EMAIL=marlaa9939@yahoo.com
SEED_ADMIN_PASSWORD=Maralmaa.1027
# Optional admin social sign-in. Register each callback URL with the provider:
# https://your-domain/api/auth/admin/google/callback
# https://your-domain/api/auth/admin/apple/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
